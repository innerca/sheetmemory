{
  "name": "sheetmemory",
  "version": "0.1.0",
  "description": "Structured typed memory plugin for OpenClaw — Perceptor pre-processing, deterministic field-filter retrieval, local-model classification",
  "type": "module",
  "license": "MIT",
  "keywords": ["openclaw", "memory", "structured-memory", "perceptor", "plugin"],
  "repository": {
    "type": "git",
    "url": "https://github.com/innerca/sheetmemory"
  },
  "dependencies": {
    "@sinclair/typebox": "1.1.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.25"
  },
  "peerDependenciesMeta": {
    "openclaw": { "optional": true }
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.4.25",
      "minGatewayVersion": "2026.4.25"
    },
    "build": {
      "openclawVersion": "2026.4.25",
      "pluginSdkVersion": "2026.4.25"
    }
  }
}
